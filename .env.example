NEXT_PUBLIC_APP_NAME=UcheWatch
NEXT_PUBLIC_SUPABASE_URL=
# Preferred: sb_publishable_... (safe for browser use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, use your legacy anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after configuring Google in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Enable only after email templates include {{ .Token }} (see docs/EMAIL_SETUP.md).
NEXT_PUBLIC_EMAIL_CODES_ENABLED=false
